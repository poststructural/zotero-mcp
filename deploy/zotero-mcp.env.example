# /opt/zotero-mcp/zotero-mcp.env  (owner zoteromcp, mode 600). Fill in on the server; never paste into chat.
ZMCP_PUBLIC_URL=https://zotero-mcp.austin-unowitz.com
ZMCP_PORT=8765
ZMCP_GITHUB_CLIENT_ID=
ZMCP_GITHUB_CLIENT_SECRET=
ZMCP_ALLOWED_GITHUB_LOGINS=Unowa001,poststructural
# generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ZMCP_JWT_SIGNING_KEY=
ZOTERO_LOCAL=false
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_NO_CLAUDE=true
ZOTERO_MCP_TOOLSETS=default,pdf-geometry
# Host/Origin guard: accept the public hostname Cloudflare passes through
FASTMCP_HTTP_ALLOWED_HOSTS='["zotero-mcp.austin-unowitz.com"]'
